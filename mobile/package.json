{
  "name": "music-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "eas build --platform all --profile production --non-interactive",
    "build:apk": "eas build -p android -e amazon-apk --non-interactive && eas build -p android -e huawei-apk --non-interactive",
    "submit": "eas submit --platform all --non-interactive"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "react": "18.2.0",
    "react-native": "0.76.0"
  },
  "devDependencies": {
    "@types/react": "~18.2.45",
    "@types/react-native": "~0.76.0",
    "babel-preset-expo": "^12.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.4.5"
  }
}
