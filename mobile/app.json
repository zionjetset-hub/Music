{
  "expo": {
    "name": "Music",
    "slug": "music",
    "version": "1.0.0",
    "scheme": "music",
    "orientation": "portrait",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
