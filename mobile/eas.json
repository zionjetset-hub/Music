{
  "cli": {
    "version": ">= 11.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "ios": { "simulator": false }
    },
    "amazon": {
      "android": { "buildType": "apk" }
    },
    "huawei": {
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "you@example.com",
        "ascApiKeyPath": "./credentials/APPLE_ASC_API_KEY.p8",
        "ascApiKeyId": "ABCD1234",
        "ascApiKeyIssuerId": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json"
      }
    }
  }
}
